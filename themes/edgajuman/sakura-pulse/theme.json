{
    "schema_version": 1,
    "id": "sakura-pulse",
    "name": "Sakura Pulse",
    "version": "1.0.0",
    "author": "Edgajuman",
    "description": "Tema anime nocturno con vidrio índigo, neón sakura, tipografía redondeada y un set completo de iconos.",
    "inherits": "dark",
    "colors": {
        "window": "#080A18",
        "panel": "#12152F",
        "panel_alt": "#191D3D",
        "surface": "#242950",
        "surface_hover": "#343B6B",
        "border": "#4B4F7D",
        "text": "#F6F4FF",
        "muted": "#B2B6D6",
        "accent": "#FF5CA8",
        "accent_hover": "#FF82BC",
        "selection": "#49386F",
        "danger": "#FF5577",
        "canvas": "#050711",
        "timeline": "#090C1E",
        "track": "#151A38"
    },
    "typography": {
        "family": "M PLUS Rounded 1c",
        "file": "assets/fonts/RoundedMplus1c-Regular.ttf",
        "size": 11
    },
    "geometry": {
        "radius": {
            "control": 10,
            "panel": 16,
            "menu": 12
        },
        "border": {
            "width": 1
        }
    },
    "materials": {
        "panel": {
            "type": "glass",
            "opacity": 0.86
        }
