    "backgrounds": {
        "window": {
            "type": "radial-gradient",
            "stops": [
                [
                    0,
                    "#20265A"
                ],
                [
                    0.48,
                    "#11152F"
                ],
                [
                    1,
                    "#080A18"
                ]
            ]
        },
        "editor": {
            "image": "assets/backgrounds/editor.webp"
        },
        "home": {
            "image": "assets/backgrounds/home.webp"
        },
        "splash": {
            "image": "assets/backgrounds/splash.webp"
        },
        "timeline": {
            "image": "assets/backgrounds/timeline.png"
        },
        "panel": {
            "image": "assets/backgrounds/panel.webp"
        }
    },
    "controls": {
        "button": {
            "background": {
                "type": "linear-gradient",
                "start": [
                    0,
                    0
                ],
                "end": [
                    1,
                    1
                ],
                "stops": [
                    [
                        0,
                        "#242950"
                    ],
                    [
                        1,
                        "#1A1F42"
                    ]
