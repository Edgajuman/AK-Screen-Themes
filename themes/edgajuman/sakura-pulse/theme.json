        },
        "primary_button": {
            "background": {
                "type": "linear-gradient",
                "start": [
                    0,
                    0
                ],
                "end": [
                    1,
                    1
                ],
                "stops": [
                    [
                        0,
                        "#7C5CFF"
                    ],
                    [
                        0.55,
                        "#C05DDF"
                    ],
                    [
                        1,
                        "#FF5CA8"
                    ]
                ]
            },
            "texture": "assets/textures/primary_button.png"
        },
        "menu": {
            "background": {
                "type": "linear-gradient",
                "start": [
                    0,
                    0
                ],
                "end": [
                    0,
                    1
                ],
                "stops": [
                    [
                        0,
                        "#1C2146"
                    ],
                    [
                        1,
                        "#0D1026"
                    ]
                ]
            },
            "texture": "assets/textures/menu.png"
        }
    },
