{
    "schema_version": 1,
    "id": "aurora-glass",
    "name": "Aurora Glass",
    "version": "1.0.0",
    "author": "TuUsuarioGitHub",
    "description": "Ejemplo de tema translúcido con acento violeta.",
    "inherits": "dark",
    "colors": {
        "window": "#090b12",
        "panel": "#171b2a",
        "panel_alt": "#1d2234",
        "surface": "#252b40",
        "surface_hover": "#303851",
        "border": "#3b4561",
        "text": "#f5f6ff",
        "muted": "#a1a8bd",
        "accent": "#8b6cff",
        "accent_hover": "#a18aff",
        "selection": "#3c316b",
        "danger": "#ff5f7c",
        "canvas": "#04050a",
        "timeline": "#10131d",
        "track": "#1b2030"
    },
    "typography": {
        "family": "Inter",
        "size": 12
    },
    "geometry": {
        "radius": {
            "control": 9,
            "panel": 14,
            "menu": 10
        },
        "border": {
            "width": 1
        }
    },
    "materials": {
        "panel": {
            "type": "glass",
            "opacity": 0.88
        }
    },
    "backgrounds": {
        "window": {
            "type": "linear-gradient",
            "start": [
                0,
                0
            ],
            "end": [
                1,
                1
            ],
            "stops": [
                [
                    0,
                    "#090b12"
                ],
                [
                    1,
                    "#18112b"
                ]
            ]
        },
        "editor": [],
        "home": [],
        "splash": [],
        "timeline": [],
        "panel": []
    },
    "controls": {
        "button": {
            "background": {
                "type": "solid",
                "color": "#252b40"
            },
            "pressed_color": "#8b6cff"
        },
        "primary_button": {
            "background": {
                "type": "linear-gradient",
                "stops": [
                    [
                        0,
                        "#7355ec"
                    ],
                    [
                        1,
                        "#a06cff"
                    ]
                ]
            }
        },
        "menu": {
            "background": {
                "type": "solid",
                "color": "#1d2234"
            }
        }
    },
    "animations": {
        "button": {
            "press": "bounce",
            "duration": 170,
            "distance": 3,
            "glow_color": "#8b6cff"
        },
        "menu": {
            "open": "fade",
            "duration": 140
        }
    },
    "icons": {
        "cursor": "assets/icons/cursor.svg"
    },
    "marketplace": {
        "preview": "preview.png",
        "tags": [
            "glass",
            "violeta",
            "macOS"
        ]
    }
}